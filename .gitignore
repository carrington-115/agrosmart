# Repository root. Per-project ignores live in agroapp/.gitignore and
# agroapi/.gitignore, which are anchored to their own directories — only rules
# that genuinely apply to the whole tree belong here.

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Secrets, belt-and-braces. Each project also ignores its own env files; this
# catches anything dropped at the root by mistake.
.env
.env.*
!.env.example

# Kubernetes manifests rendered with real values. Templates under deploy/ are
# committed; anything ending -local or -secret is not.
deploy/**/*-local.yaml
deploy/**/*-secret.yaml
