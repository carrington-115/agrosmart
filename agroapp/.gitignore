# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is the opt-in that comment anticipates, and create-next-app's
# blanket .env* had been quietly swallowing it: agroapp/.env.example existed on
# disk but was never tracked, so a fresh clone got no frontend env template at
# all and had to infer the variable names from the code. agroapi/.env.example is
# committed and this is meant to match it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
