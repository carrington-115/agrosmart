# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
# Required by /api/ingest so sensor nodes can write readings without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the firmware sends as the `x-device-key` header on /api/ingest.
# Generate one with: openssl rand -hex 32
SENSOR_INGEST_KEY=

# Base URL of agroapi. Server-only and deliberately NOT prefixed NEXT_PUBLIC_:
# that prefix inlines a value into the client bundle at build time, and this
# address differs per environment — http://agroapi:8080 inside docker compose,
# the value below from a host dev server, a real hostname in production. Baking
# it in would mean one image per environment to communicate a hostname.
#
# Read through lib/api.ts, which throws naming this variable rather than
# defaulting, so a missing value cannot be mistaken for a backend outage.
AGRO_API_URL=http://localhost:8080
