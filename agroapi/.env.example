# Copy to .env. Every AGRO_-prefixed variable below is read by src/agroapi/config.py.
#
# The three at the top have no defaults on purpose: the process refuses to start
# without them rather than failing at first request. That is a direct lesson from
# the Next.js ingest route this service replaces, which returned 503 on every call
# because its environment was incomplete and nothing anywhere said so.

# --- required ----------------------------------------------------------------

# Connect as the least-privileged `agro_api` role (see
# ../agroapp/supabase/setup_api_role.sql), NEVER as `postgres` — `postgres` owns
# these tables and holds BYPASSRLS, which would make every policy inert.
#
# Prefer the direct connection on :5432 over the Supavisor pooler. This is a
# long-lived process holding its own pool, so the pooler buys nothing and imports
# transaction-mode hazards.
#
# Against the throwaway Postgres from `docker compose --profile test up -d db`:
#   postgresql://postgres:postgres@localhost:55432/agrosmart_test
AGRO_DATABASE_URL=postgresql://agro_api:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Used to derive the JWKS URL that dashboard access tokens are verified against.
AGRO_SUPABASE_URL=https://PROJECT_REF.supabase.co

# HMAC pepper for device tokens. Keeps a leaked database dump from yielding
# usable credentials, so it belongs in the environment and NOT in the database.
# Rotating it invalidates every device token already flashed to a node.
#   openssl rand -hex 32
AGRO_TOKEN_PEPPER=

# --- optional, defaults shown ------------------------------------------------

# Origins allowed to call the read API. Comma-separated. The dashboard runs on a
# different origin so it needs CORS; devices do not, being no kind of browser.
#AGRO_CORS_ORIGINS=http://localhost:3000

# Zero on purpose — see the comment in config.py. A non-zero minimum makes an
# unreachable database a STARTUP failure, which in Kubernetes is a crash-loop
# during a transient Supabase blip.
#AGRO_DB_POOL_MIN_SIZE=0
#AGRO_DB_POOL_MAX_SIZE=10

# Set to 0 only when forced onto Supavisor transaction mode (:6543), where
# asyncpg's prepared-statement names collide across pooled clients.
#AGRO_DB_STATEMENT_CACHE_SIZE=100

# Payload envelope versions this build understands. An unknown version is
# rejected rather than best-effort decoded, so a firmware rollout cannot silently
# write misinterpreted numbers.
#AGRO_SUPPORTED_PAYLOAD_VERSIONS=[1]

# Largest accepted batch. A six-hour outage at the firmware's 60 s cadence is
# ~360 readings, so this bounds a replay to four requests.
#AGRO_MAX_BATCH_SIZE=100

# A sensor with no arrival newer than this is reported offline. Three times the
# firmware's SAMPLE_INTERVAL_MS, so one missed transmission is not a dead node.
#AGRO_OFFLINE_AFTER_SECONDS=180
