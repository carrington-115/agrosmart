# Copy to .env at the repository root. Docker Compose reads it automatically and
# substitutes these into docker-compose.yml and docker-compose.dev.yml.
#
# This file configures the COMPOSE STACK. The two services keep their own env
# files for running them directly — agroapi/.env.example and
# agroapp/.env.example — and neither is read by compose.
#
# Every variable below is written `${VAR:?message}` in the compose files rather
# than given a default, so a missing one fails immediately with its own name
# instead of silently connecting somewhere unintended.

# --- agroapi -----------------------------------------------------------------

# Connect as the least-privileged `agro_api` role, NEVER as `postgres`, which owns
# these tables and holds BYPASSRLS — every policy would be inert. See
# agroapp/supabase/setup_api_role.sql. Prefer the direct connection on :5432 over
# the Supavisor pooler.
AGRO_DATABASE_URL=postgresql://agro_api:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Derives the JWKS URL that dashboard access tokens are verified against. The
# readiness probe performs a real HTTPS GET here, so it must name a live project.
AGRO_SUPABASE_URL=https://PROJECT_REF.supabase.co

# HMAC pepper for device tokens: openssl rand -hex 32
# Rotating it invalidates every device token already flashed to a node.
AGRO_TOKEN_PEPPER=

# --- agroapp -----------------------------------------------------------------

# Inlined into the client bundle at build time, which is why docker-compose.yml
# passes them as build args rather than environment. Publishable by definition —
# the anon key already ships to every browser.
#
# docker-compose.dev.yml does NOT need these: `next dev` reads agroapp/.env.local
# from the mounted working tree at request time.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SUPABASE_SERVICE_ROLE_KEY is deliberately absent and must never be added here.
# It bypasses RLS, and compose passes the NEXT_PUBLIC_ values above as build args,
# which bake them into an image layer.
#
# AGRO_API_URL is absent too, on purpose: inside compose it is always
# http://agroapi:8080 and the compose files set it directly. It is configuration
# only when running the dashboard outside the stack.
